{
  "name": "freeform-mcp",
  "version": "1.0.0",
  "description": "Apple Freeform bağlantısı: Claude'un diyagram, akış şeması ve zihin haritası çizmesi ile mevcut panoları okuması için MCP sunucusu (macOS).",
  "author": {
    "name": "Chris van Wyk",
    "url": "https://github.com/ChrisvW56"
  },
  "homepage": "https://github.com/ChrisvW56/freeform-mcp",
  "repository": "https://github.com/ChrisvW56/freeform-mcp",
  "license": "MIT",
  "keywords": [
    "freeform",
    "diagrams",
    "whiteboard",
    "macos",
    "mcp",
    "flowchart",
    "mindmap"
  ],
  "requirements": {
    "os": "macos",
    "python": ">=3.10",
    "install": "pip3 install -r requirements.txt"
  },
  "mcpServers": {
    "freeform": {
      "command": "python3",
      "args": ["${PLUGIN_ROOT}/freeform_mcp_server.py"]
    }
  },
  "clients": {
    "claude": {
      "configKey": "mcpServers",
      "server": {
        "freeform": {
          "command": "python3",
          "args": ["${PLUGIN_ROOT}/freeform_mcp_server.py"]
        }
      }
    },
    "antigravity": {
      "configFile": "~/.gemini/config/mcp_config.json",
      "configKey": "mcpServers",
      "server": {
        "freeform-mcp": {
          "command": "python3",
          "args": ["${PLUGIN_ROOT}/freeform_mcp_server.py"]
        }
      }
    },
    "opencode": {
      "configFile": "~/.config/opencode/opencode.jsonc",
      "configKey": "mcp",
      "server": {
        "Freeform": {
          "type": "local",
          "command": ["python3", "${PLUGIN_ROOT}/freeform_mcp_server.py"]
        }
      }
    },
    "codex": {
      "pluginDir": "~/.codex/plugins/freeform-mcp",
      "files": {
        ".codex-plugin/plugin.json": "Codex plugin manifest",
        ".mcp.json": "MCP server config for Codex"
      }
    }
  }
}